    "motion-v": "^2.8.0",
    "photoswipe": "^5.4.4",
    "vue": "^3.5.44",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
