{
  "name": "mosaic-frontend",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "description": "Interfaccia di Mosaic 2 (Vue 3). Palette dai colori del logo (scripts/build-palette.mjs): vedi docs/rebuild/UI_SPEC.md",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
